{{!
    Page footer.
}}
<div id="goto-top-link">
    {{! go to top is sticky to footer so needs to be sibling }}
    <a class="btn btn-dark icon-no-margin mr-3" role="button" href="#topofscroll">
        {{#pix}} i/up, core, {{#str}} totop, theme_envf {{/str}}{{/pix}}
    </a>
</div>
<footer id="page-footer" class="py-3 text-dark overflow-hidden">
    <div class="container position-relative">
        <div class="mcms-square square-dual-blue d-none d-lg-block"></div>
        <div class="container-fluid infos-footer">
            <div class="row justify-content-between">
                <div class="col-12 col-lg-8 align-self-start">
                    <div class="container mt-3">
                        <div class="row">
                            <div class="col d-none d-md-flex">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="d-flex flex-row justify-content-between align-items-center w-100 logos-header">
                                        <div class="align-self-start mx-3 mb-auto">
                                            <img src="{{{ config.wwwroot }}}/theme/envf/pix/rf.png" role="presentation"
                                                 alt="{{#str}}ministereagriculture, theme_envf{{/str}}">
                                        </div>
                                        <div class="flex-grow-1 font-weight-bold text-center mx-3 mb-auto">
                                            {{#str}} envf, theme_envf {{/str}}
                                        </div>
                                    </div>

                                    <ul class="list-unstyled pt-3 d-flex flex-column addresses school-org-list">
                                        {{# additionalinfo.orglist }}
                                            <li class="d-flex school-item">
                                                <img src="{{url}}" role="presentation" alt="{{ label }}" class="mx-3 align-self-start"/>
                                                <a href="{{link}}" class="align-self-center mx-3" target="_blank">{{ address }} </a>
                                            </li>
                                        {{/ additionalinfo.orglist }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4 d-flex align-self-start">
                    <nav class="nav navbar-nav custom-menu-footer mt-3 ml-3" aria-label="{{#str}}custommenu, admin{{/str}}">
                        {{# output.mcms_menu_menu_flat }}
                            <ul class="list-unstyled">
                                {{> theme_boost/custom_menu_footer }}
                            </ul>
                        {{/ output.mcms_menu_menu_flat }}
                    </nav>
                </div>

            </div>
        </div>
    </div>
    <div data-region="footer-container-popover">
        {{#output.has_communication_links}}
            <button onclick="window.open('{{output.communication_url}}', '_blank', 'noreferrer')" class="btn btn-icon bg-primary text-white icon-no-margin btn-footer-communication"
                    aria-label="{{#str}}communicationroomlink, course{{/str}}">
                {{#pix}}t/messages-o, core{{/pix}}
            </button>
        {{/output.has_communication_links}}
        <button class="btn btn-icon bg-secondary icon-no-margin btn-footer-popover" data-action="footer-popover" aria-label="{{#str}}showfooter, theme_boost{{/str}}">
            {{#pix}}e/question, core{{/pix}}
        </button>
    </div>
    <div class="footer-content-popover container" data-region="footer-content-popover">
        {{#output.has_communication_links}}
            <div class="footer-section p-3 border-bottom footer-link-communication">
                <div class="footer-support-link">{{{ output.communication_link }}}</div>
            </div>
        {{/output.has_communication_links}}
        {{# output.has_popover_links }}
            <div class="footer-section p-3 border-bottom">
                {{# output.page_doc_link }}
                    <div class="footer-support-link">{{{ output.page_doc_link }}}</div>
                {{/ output.page_doc_link }}

                {{# output.services_support_link }}
                    <div class="footer-support-link">{{{ output.services_support_link }}}</div>
                {{/ output.services_support_link }}

                {{# output.supportemail }}
                    <div class="footer-support-link">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}
            </div>
        {{/ output.has_popover_links }}
        <div class="footer-section p-3 border-bottom">
            <div class="logininfo">
                {{{ output.login_info }}}
            </div>
            <div class="tool_usertours-resettourcontainer">
            </div>

            {{{ output.standard_end_of_body_html }}}
        </div>
        <div class="footer-section p-3">
            <div>{{#str}}poweredbymoodle, core{{/str}}</div>
            {{#output.moodle_release}}
                <div>
                    {{#str}}version, core{{/str}} {{{ output.moodle_release }}}
                </div>
            {{/output.moodle_release}}
        </div>
    </div>
    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
<div class="container legalinfo small">
    <div class="row justify-content-center">
        {{# additionalinfo.legallinks }}
            <a href="{{link}}">{{label}}</a>
        {{/ additionalinfo.legallinks }}
        {{{ output.standard_footer_html }}}
    </div>
</div>
{{#js}}
    require(['theme_boost/footer-popover'], function(FooterPopover) {
    FooterPopover.init();
    });
{{/js}}
